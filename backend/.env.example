# =============================================================================
# OkDriver Backend — Environment Variable Reference
# Copy this to .env and fill in real values. Never commit the real .env.
# =============================================================================

APP_NAME=okDriver CCTV Intelligence Platform
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<generate-a-real-secret>

ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite+aiosqlite:///./okdriver.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
MEDIAMTX_HLS_BASE_URL=http://localhost:8888
MEDIAMTX_WEBRTC_BASE_URL=http://localhost:8889
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=okdriver-evidence
S3_ACCESS_KEY=<your-minio-access-key>
S3_SECRET_KEY=<your-minio-secret-key>
